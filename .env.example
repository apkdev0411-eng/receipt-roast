# Copia este archivo a .env.local y pega tu key.
# Nunca subas .env.local al repositorio.

# Obligatoria para usar la API real de xAI / Grok.
# Consíguela en https://console.x.ai/
XAI_API_KEY=

# Opcional: forzar modo demo aunque exista una key.
# DEMO_MODE=true

# Modelos (OpenAI-compatible en https://api.x.ai/v1).
# Ambos aceptan visión en grok-4+; ajústalos si xAI renombra IDs.
XAI_VISION_MODEL=grok-4
XAI_TEXT_MODEL=grok-4
